{
  "name": "@workspace/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "LabyrinthV8 desktop app — runs the dashboard and API server locally so full-system scans see the machine it's installed on, not a remote host.",
  "author": {
    "name": "Blu Corbel aka DeadmanXXXII",
    "username": "HevvyDevvy",
    "email": "blucorbel35@gmail.com"
  },
  "homepage": "https://github.com/HevvyDevvy/LabyrinthV8",
  "desktopName": "LabyrinthV8",
  "main": "electron-main.cjs",
  "scripts": {
    "prepare-resources": "node ./scripts/prepare.mjs",
    "dev": "pnpm run prepare-resources && electron .",
    "dist": "pnpm run prepare-resources && electron-builder"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "26.15.7"
  },
  "build": {
    "appId": "io.github.hevvydevvy.labyrinthv8",
    "productName": "LabyrinthV8",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "files": [
      "electron-main.cjs",
      "package.json"
    ],
    "extraResources": [
      { "from": "resources/server", "to": "server" },
      { "from": "resources/dashboard", "to": "dashboard" }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "build-resources/icon.png",
      "target": ["dmg"]
    },
    "win": {
      "icon": "build-resources/icon.png",
      "target": ["nsis", "appx"],
      "publisherName": "BB6CF6A1-F89B-484C-85F4-1A7E35694B74",
      "signingHashAlgorithms": ["sha256"],
      "signtoolOptions": {
        "rfc3161TimeStampServer": "http://timestamp.digicert.com",
        "signToolPath": "C:\\Program Files (x86)\\Windows Kits\\10\\bin\\10.0.26100.0\\x64\\signtool.exe"
      }
    },
    "appx": {
      "identityName": "TMHP.com.LabyrinthV8",
      "publisher": "CN=BB6CF6A1-F89B-484C-85F4-1A7E35694B74",
      "publisherDisplayName": "@TMHP.com",
      "applicationId": "LabyrinthV8"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build-resources/icon.png",
      "category": "Utility",
      "target": ["AppImage", "deb"],
      "executableName": "LabyrinthV8"
    }
  }
  }
